.cpu Z80
.org 0x8000
.engine test


Print_A_As_HEX:
                PUSH AF
                RRCA
                RRCA
                RRCA
                RRCA
                AND 15
                CP 10
                JR C, High_Digit_0_9
                ADD A, 55           
                JR High_Print
High_Digit_0_9:
                ADD A, 48           
High_Print:
                OUT (1), A

                POP AF
                AND 15
                CP 10
                JR C, Low_Digit_0_9
                ADD A, 55           
                JR Low_Print
Low_Digit_0_9:
                ADD A, 48           
Low_Print:
                OUT (1), A
                RET

main:           IN A,(0)
                AND 1
                JR Z,main
                IN A,(1)
                ;CALL PRINT_A_AS_HEX
                OUT (1),A
                XOR 0x0D    ; Check If Its Enter(CR).
                JR NZ,main
                LD A,0x0A   ; Insert a New Line \n
                ; Backspace and Del Work In Progress
                OUT (1),A
                JP main
.ent main
