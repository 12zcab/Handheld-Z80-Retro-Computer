8000   48 45 4C 4C 4F 20 57 4F 52 4C 44 21 HELLO_WORLD:   DB   "H","E","L","L","O"," ","W","O","R","L","D","!"   
800C   D3 01        PRINT:    OUT   (1),A   
800E   C9                     RET      
800F   06 0C        MAIN:     LD   B,0x0C   
8011   21 00 80               LD   HL,Hello_World   
8014   7E           LOOP:     LD   A,(HL)   
8015   CD 0C 80               CALL   Print   
8018   23                     INC   HL   
8019   05                     DEC   B   
801A   20 F8                  JR   NZ,loop   
801C   76                     HALT      
801D                             ; 
801D                          .ENT   main   


