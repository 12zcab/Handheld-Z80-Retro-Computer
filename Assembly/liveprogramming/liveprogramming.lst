0000                          .CPU   Z80   
0000                          .ORG   0x0000   
0000                          .ENGINE   liveprogramming/liveprogramming   
0000                             ; 
0000                             ;CONFIGS
0000                LENGTH:   EQU   32   
0000   D5           RESET_BUFFER:   PUSH   DE   
0001   C5                     PUSH   BC   
0002   36 20                  LD   (HL)," "   
0004   CD 18 00               CALL   PRINT_BUFFER   
0007   21 20 80               LD   HL,$8020   
000A   11 00 80               LD   DE,$8000   
000D   01 20 00               LD   BC,32   
0010   ED B0                  LDIR      
0012   C1                     POP   BC   
0013   D1                     POP   DE   
0014   21 00 80               LD   HL,Line_Buffer_16   
0017   C9                     RET      
0018   E5           PRINT_BUFFER:   PUSH   HL   ;Preserve HL,BC,AF
0019   C5                     PUSH   BC   
001A   F5                     PUSH   AF   
001B   21 00 80               LD   HL,LINE_BUFFER_16   ;Load Buffer Pointer
001E   06 20                  LD   B,LENGTH   ;Load Buffer Size
0020   3E 0D                  LD   A,0x0D   ;Move back to the beginning of the line
0022   D3 01                  OUT   (1),A   ;Output the CR character
0024   7E           PRINT_LOOP:   LD   A,(HL)   ;Load Character from Buffer
0025   FE 7C                  CP   "|"   
0027   20 06                  JR   NZ,PRT_Continue   
0029   CB 71                  BIT   6,C   
002B   20 02                  JR   NZ,PRT_CONTINUE   
002D   18 02                  JR   PRT_Finally   
002F   D3 01        PRT_CONTINUE:   OUT   (1),A   ;Output Character
0031   23           PRT_FINALLY:   INC   HL   ;Increase Buffer Pointer
0032   05                     DEC   B   ;Decrease Counter
0033   20 EF                  JR   NZ,print_loop   ;Check Counter and continue loop if nonZero
0035   F1                     POP   AF   ;Restore AF BC HL
0036   C1                     POP   BC   
0037   E1                     POP   HL   
0038   C9                     RET      
0039   31 FF FF     INIT:     LD   SP,$FFFF   ;Init Stack
003C   21 00 80               LD   HL,LINE_BUFFER_16   ;Init Pointer
003F   11 1F 80               LD   DE,LINE_BUFFER_16 + LENGTH - 1   ;Limit the Character Per Line
0042   CD 00 00               CALL   reset_buffer   
0045   C3 48 00               JP   main   
0048   CD 18 00     MAIN:     CALL   PRINT_BUFFER   ;Update Console
004B   0C                     INC   C   
004C   DB 00                  IN   A,(0)   ;Check if Incoming Character
004E   E6 01                  AND   1   ;Check the LSB
0050   28 F6                  JR   Z,main   ;Skip Loop If Nothing is comming from Console :|
0052                             ; 
0052   DB 01                  IN   A,(1)   ;Input Character
0054   E5                     PUSH   HL   ;Preserve HL
0055   2B                     DEC   HL   ;DEC for Checking
0056   CB 7C                  BIT   7,H   ;Check If Less Than 0x8000 After Decrease by 1
0058   E1                     POP   HL   ;Restore HL (Does not affect flags)
0059   28 0B                  JR   Z,ContinueSpecM1   ;Ignore BackSpace if it will cause UnderFlow
005B   FE 08                  CP   0x08   ;Check if its BackSpace
005D   20 07                  JR   NZ,ContinueSpecM1   ;If Not,Skip
005F   36 20                  LD   (HL)," "   ;Clear Current Buffer Pointer Address Data
0061   2B                     DEC   HL   ;Decrease the Buffer Pointer Address
0062   36 7C                  LD   (HL),"|"   ;Replace with the "|" symbol
0064   18 E2                  JR   main   ;Continue the Loop as BackSpace is already handled
0066   FE 0D        CONTINUESPECM1:   CP   0x0D   
0068   20 0A                  JR   NZ,ContinueSpecM2   
006A   CD 00 00               CALL   reset_buffer   
006D   3E 0A                  LD   A,0x0A   
006F   D3 01                  OUT   (1),A   
0071   C3 48 00               JP   main   
0074   EB           CONTINUESPECM2:   EX   DE,HL   ;Exchange HL and DE for Difference Calculation
0075   E5                     PUSH   HL   ;Preserve HL
0076   A7                     AND   A   ;Clear Flag
0077   ED 52                  SBC   HL,DE   ;to HL-DE (but it was exchanged so its actually DE-HL)
0079   E1                     POP   HL   ;restore HL(But Actually Storing DE's content ) , not affecting Flags
007A   EB                     EX   DE,HL   ;Exchange HL back
007B   28 CB                  JR   Z,main   ;If Reached Limit,Ignore Input
007D   77                     LD   (HL),A   ;Load Character into Buffer
007E   23                     INC   HL   ;Inc Buffer Pointer
007F   36 7C                  LD   (HL),0x7C   ;Load Character "|" on to the next place
0081   C3 48 00               JP   main   ;LOOP
0084                          .ENT   init   ;Boot in INIT (For Better Compatibility,put init onto 0x0000 for CP/M etc. execution)
8000                          .ORG   0x8000   ;RAM Part
8000   20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 LINE_BUFFER_16:   DB   " "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "   ;Default Line_Buffer
8020   7C 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 LINE_BUFFER_16_DEFAULT:   DB   "|"," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "   
