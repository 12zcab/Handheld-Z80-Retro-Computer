0000                          .CPU   Z80   
0000                          .ORG   0x0000   
0000                          .ENGINE   liveprogramming/liveprogramming   
0000                             ; 
0000                             ;CONFIGS
0000                LENGTH:   EQU   32   
0000                             ; 
0000   E5           PRINT_BUFFER:   PUSH   HL   ;Preserve HL,BC,AF
0001   C5                     PUSH   BC   
0002   F5                     PUSH   AF   
0003   21 00 80               LD   HL,LINE_BUFFER_16   ;Load Buffer Pointer
0006   06 20                  LD   B,LENGTH   ;Load Buffer Size
0008   3E 0D                  LD   A,0x0D   ;Move back to the beginning of the line
000A   D3 01                  OUT   (1),A   ;Output the CR character
000C   7E           PRINT_LOOP:   LD   A,(HL)   ;Load Character from Buffer
000D   D3 01                  OUT   (1),A   ;Output Character
000F   23                     INC   HL   ;Increase Buffer Pointer
0010   05                     DEC   B   ;Decrease Counter
0011   20 F9                  JR   NZ,print_loop   ;Check Counter and continue loop if nonZero
0013   F1                     POP   AF   ;Restore AF BC HL
0014   C1                     POP   BC   
0015   E1                     POP   HL   
0016   C9                     RET      
0017   31 FF FF     INIT:     LD   SP,$FFFF   ;Init Stack
001A   21 00 80               LD   HL,LINE_BUFFER_16   ;Init Pointer
001D   11 1F 80               LD   DE,LINE_BUFFER_16 + LENGTH - 1   ;Limit the Character Per Line
0020   C3 23 00               JP   main   
0023   CD 00 00     MAIN:     CALL   PRINT_BUFFER   ;Update Console
0026                             ; 
0026   DB 00                  IN   A,(0)   ;Check if Incoming Character
0028   E6 01                  AND   1   ;Check the LSB
002A   28 F7                  JR   Z,main   ;Skip Loop If Nothing is comming from Console :|
002C                             ; 
002C   DB 01                  IN   A,(1)   ;Input Character
002E   E5                     PUSH   HL   ;Preserve HL
002F   2B                     DEC   HL   ;DEC for Checking
0030   CB 7C                  BIT   7,H   ;Check If Less Than 0x8000 After Decrease by 1
0032   E1                     POP   HL   ;Restore HL (Does not affect flags)
0033   28 0B                  JR   Z,ContinueSpecM1   ;Ignore BackSpace if it will cause UnderFlow
0035   FE 08                  CP   0x08   ;Check if its BackSpace
0037   20 07                  JR   NZ,ContinueSpecM1   ;If Not,Skip
0039   36 20                  LD   (HL)," "   ;Clear Current Buffer Pointer Address Data
003B   2B                     DEC   HL   ;Decrease the Buffer Pointer Address
003C   36 7C                  LD   (HL),"|"   ;Replace with the "|" symbol
003E   18 E3                  JR   main   ;Continue the Loop as BackSpace is already handled
0040   EB           CONTINUESPECM1:   EX   DE,HL   ;Exchange HL and DE for Difference Calculation
0041   E5                     PUSH   HL   ;Preserve HL
0042   A7                     AND   A   ;Clear Flag
0043   ED 52                  SBC   HL,DE   ;to HL-DE (but it was exchanged so its actually DE-HL)
0045   E1                     POP   HL   ;restore HL(But Actually Storing DE's content ) , not affecting Flags
0046   EB                     EX   DE,HL   ;Exchange HL back
0047   28 DA                  JR   Z,main   ;If Reached Limit,Ignore Input
0049   77                     LD   (HL),A   ;Load Character into Buffer
004A   23                     INC   HL   ;Inc Buffer Pointer
004B   36 7C                  LD   (HL),0x7C   ;Load Character "|" on to the next place
004D   C3 23 00               JP   main   ;LOOP
0050                          .ENT   init   ;Boot in INIT (For Better Compatibility,put init onto 0x0000 for CP/M etc. execution)
8000                          .ORG   0x8000   ;RAM Part
8000   7C 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 LINE_BUFFER_16:   DB   "|"," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "   ;Default Line_Buffer
8020                             ; 
