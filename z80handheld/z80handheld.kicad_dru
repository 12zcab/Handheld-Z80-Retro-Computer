(version 1)
(rule "Ignore Clearance In Area"
  (constraint clearance (min 0mm))
  (condition "A.insideArea('IgnoreZone') && B.insideArea('IgnoreZone')"))

(rule "Ignore Courtyard Overlap In Area"
  (constraint courtyard_clearance (min 0mm))
  (condition "A.insideArea('IgnoreZone') && B.insideArea('IgnoreZone')"))

(rule "Allow Any Track Width In Area"
  (constraint track_width (min 0mm))
  (condition "A.insideArea('IgnoreZone')"))
